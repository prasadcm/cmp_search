{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "refresh_interval": "1s",
    "analysis": {
      "analyzer": {
        "cmp_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "char_filter": ["html_strip"],
          "filter": ["apostrophe", "asciifolding", "trim", "stop", "lowercase"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "phone_number": {
        "type": "keyword"
      },
      "email": {
        "type": "keyword"
      },
      "name": {
        "type": "text",
        "analyzer": "cmp_analyzer",
        "index": true
      },
      "updated_at": {
        "type": "date"
      },
      "search_text": {
        "type": "text",
        "analyzer": "cmp_analyzer",
        "index": true,
        "fields": {
          "raw": {
            "type": "keyword"
          }
        }
      },
      "icon_url": {
        "type": "text",
        "index": false
      },
      "type": {
        "type": "keyword"
      },
      "slug": {
        "type": "keyword"
      },
      "product_id": {
        "type": "keyword"
      },
      "category_id": {
        "type": "keyword"
      },
      "search_count": {
        "type": "rank_feature"
      },
      "popularity": {
        "type": "rank_feature"
      }
    }
  }
}
