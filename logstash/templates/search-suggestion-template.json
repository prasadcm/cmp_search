{
    "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "refresh_interval": "1s",
    "analysis": {
        "tokenizer": {
        "autocomplete_tokenizer": {
            "type": "edge_ngram",
            "min_gram": 1,
            "max_gram": 20,
            "token_chars": ["letter", "digit"]
        }
        },
        "analyzer": {
            "autocomplete_analyzer": {
                "type": "custom",
                "tokenizer": "autocomplete_tokenizer",
                "char_filter": ["html_strip"],
                "filter": ["lowercase", "asciifolding", "trim", "stop"]
            },
            "autocomplete_search_analyzer": {
            "type": "custom",
            "tokenizer": "autocomplete_tokenizer",
            "char_filter": ["html_strip"],
            "filter": ["lowercase", "asciifolding", "trim", "stop"]
            }
        }
    }
    },
    "mappings": {
        "properties": {
            "type": {
                "type": "keyword"
            },
            "name": {
                "type": "text",
                "analyzer": "autocomplete_analyzer",
                "search_analyzer": "autocomplete_search_analyzer",
                "fields": {
                    "keyword": {
                        "type": "keyword"
                    }
                }
            },
            "tags": {
                "type": "text",
                "analyzer": "autocomplete_analyzer",
                "search_analyzer": "autocomplete_search_analyzer"
            },
            "slug": {
                "type": "keyword"
            },
            "icon_url": {
                "type": "keyword",
                "index": false
            },
            "product_id": {
                "type": "keyword"
            },
            "category_id": {
                "type": "keyword"
            },
            "is_bestseller": {
                "type": "boolean"
            },
            "new_arrival": {
                "type": "boolean"
            },
            "is_featured": {
                "type": "boolean"
            },
            "in_stock": {
                "type": "boolean"
            },
            "discount": {
                "type": "float"
            },
            "search_count": {
                "type": "long"
            },
            "popularity": {
                "type": "float"
            },
            "updated_at": {
                "type": "date"
            }
        }
    }
}
