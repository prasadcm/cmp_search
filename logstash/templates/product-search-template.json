{
    "settings": {
        "number_of_shards": 1,
        "number_of_replicas": 1,
        "refresh_interval": "1s",
        "analysis": {
            "char_filter": {
                "html_strip_char_filter": {
                    "type": "html_strip"
                }
            },
            "filter": {
                "custom_stop": {
                    "type": "stop",
                    "stopwords": "_english_"
                }
            },
            "analyzer": {
                "plp_name_analyzer": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "char_filter": ["html_strip_char_filter"],
                    "filter": ["lowercase", "asciifolding", "trim"]
                },
                "plp_description_analyzer": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "char_filter": ["html_strip_char_filter"],
                    "filter": ["lowercase", "asciifolding", "trim", "custom_stop"]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "product_id":   { "type": "keyword" },
            "name": {
                "type": "text",
                "analyzer": "plp_name_analyzer",
                "fields": {
                    "keyword": { "type": "keyword" }
                }
            },
            "description": {
                "type": "text",
                "analyzer": "plp_description_analyzer"
            },
            "product_type": { "type": "keyword", "index": false },
            "thumb_image":    { "type": "keyword", "index": false },
            "in_stock":     { "type": "boolean" },
            "price":        { "type": "float" },
            "discount":     { "type": "float" },
            "currency":     { "type": "keyword" , "index": false },
            "rating":       { "type": "float" },
            "savings_message": { "type": "keyword", "index": false },
            "promotional_message": { "type": "keyword", "index": false },
            "is_bestseller":    { "type": "boolean" },
            "new_arrival":         { "type": "boolean" },
            "is_featured":         { "type": "boolean" },
            "categories": {
                "type": "nested",
                "properties": {
                    "id": { "type": "keyword" },
                    "name": { "type": "keyword" }
                }
            },
            "brand":        { "type": "keyword" },
            "search_count": { "type": "long" },
            "popularity":   { "type": "float" },
            "created_at":   { "type": "date" },
            "updated_at":   { "type": "date" },
            "tags": {
                "type": "text",
                "analyzer": "plp_name_analyzer"
            },
            "attributes": {
                "type": "nested",
                "properties": {
                    "name": { "type": "keyword", "index": false },
                    "value": { "type": "keyword", "index": false }
                }
            },
            "variants": {
                "type": "nested",
                "properties": {
                    "sku": { "type": "keyword" },
                    "color": { "type": "keyword" },
                    "size": { "type": "keyword" },
                    "price": { "type": "float" },
                    "discount": { "type": "float" },
                    "in_stock": { "type": "boolean" },
                    "thumb_image": { "type": "keyword", "index": false },
                    "swatch_images": { "type": "keyword", "index": false }
                }
            }
        }
    }
}
